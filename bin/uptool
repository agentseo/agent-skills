#!/usr/bin/env bash
# uptool — unified update checker/installer for omp, claude, codex, rtk, herdr, skills.
# Usage:
#   uptool            # check everything, then prompt y/N per group to install
#   uptool -c|--check # check only, never install (good for cron/login banner)
#   uptool -y|--yes   # install omp + npm globals + herdr (stable) without prompting; rtk still asks
#   uptool -a|--auto  # fully unattended: also reinstalls rtk (pinned + SHA-verified)
# Skills are report-only in EVERY mode: applying a skill diff stays a reviewed step
# (skill-sync approve/apply). Never automated here, not even under -a.
# herdr on the preview channel is report-only too (installed build id is not comparable),
# and no herdr install is ever attempted from inside a herdr session.
set -uo pipefail

# --- config: rtk has no self-update. Official update = brew, else re-run the installer.
# The installer is PINNED to a reviewed commit and its SHA-256 is verified before running
# (installer itself downloads the release binary and verifies checksums.txt). Re-pin after review:
#   gh api repos/rtk-ai/rtk/commits/master --jq .sha
#   curl -fsSL https://raw.githubusercontent.com/rtk-ai/rtk/<sha>/install.sh | sha256sum
RTK_REPO="rtk-ai/rtk"
RTK_PIN_SHA="5a7880d404db8364d602f2ecdc41dd790f64013f"
RTK_INSTALL_SHA256="d6eb73a772903e13ff34ee1be8a8b24e896ba9a978f20d2279a08b4083ea6f77"
SKILL_DIRS=("$HOME/.claude/skills" "$HOME/.omp/agent/skills")

CHECK_ONLY=0; ASSUME_YES=0; AUTO_EXEC=0
case "${1:-}" in
  -c|--check) CHECK_ONLY=1 ;;
  -y|--yes)   ASSUME_YES=1 ;;
  -a|--auto)  ASSUME_YES=1; AUTO_EXEC=1 ;;
  -h|--help)  sed -n '2,11p' "$0"; exit 0 ;;
esac

bold=$'\e[1m'; dim=$'\e[2m'; grn=$'\e[32m'; ylw=$'\e[33m'; red=$'\e[31m'; rst=$'\e[0m'
hdr(){ printf '\n%s== %s ==%s\n' "$bold" "$1" "$rst"; }
ask(){ # $1 = prompt; returns 0 to proceed
  [ "$CHECK_ONLY" = 1 ] && return 1
  [ "$ASSUME_YES" = 1 ] && return 0
  local a=""; read -r -p "$1 [y/N] " a </dev/tty || true; [[ "$a" =~ ^[Yy]$ ]]
}
# exec-tier confirm: -y is NOT enough (curl|sh must be seen). Only -a auto-approves,
# and only because the installer is pinned and its SHA-256 verified before it runs.
ask_exec(){
  [ "$CHECK_ONLY" = 1 ] && return 1
  [ "$AUTO_EXEC" = 1 ] && return 0
  local a=""; read -r -p "$1 [y/N] " a </dev/tty || true; [[ "$a" =~ ^[Yy]$ ]]
}

# ---------- omp (native self-update) ----------
hdr "omp"
if command -v omp >/dev/null; then
  cur=$(omp --version 2>/dev/null)
  echo "installed: $cur"
  omp_out=$(timeout 60 omp update -c 2>&1); omp_rc=$?
  printf '%s\n' "$omp_out" > /tmp/uptool.omp
  if [ "$omp_rc" -ne 0 ]; then
    # includes timeout (124) and omp's own "Failed to check for updates" (rc 1)
    printf '%scheck failed (rc %s) — skipped, nothing installed%s\n' "$ylw" "$omp_rc" "$rst"
    sed -n '1,4p' /tmp/uptool.omp
  elif printf '%s\n' "$omp_out" | grep -qiE 'up[ -]?to[ -]?date|no (new )?updates?'; then
    printf '%sup to date%s\n' "$grn" "$rst"
  else
    # rc 0 without the up-to-date marker = something to install; `omp update` is a no-op if not
    printf '%supdate available%s\n' "$ylw" "$rst"; sed -n '1,4p' /tmp/uptool.omp
    if ask "install omp update (+plugins)?"; then omp update && omp update -l; fi
  fi
else echo "${dim}omp not found${rst}"; fi

# ---------- npm globals: claude + codex ----------
hdr "npm globals (claude, codex)"
if command -v npm >/dev/null; then
  npm_out=$(timeout 120 npm outdated -g 2>/dev/null); npm_rc=$?   # rc 1 = outdated found (normal)
  out=$(printf '%s\n' "$npm_out" | grep -Ei '@anthropic-ai/claude-code|@openai/codex')
  if [ "$npm_rc" -gt 1 ]; then
    printf '%scheck failed (rc %s; 124 = 120s timeout) — skipped, nothing installed%s\n' "$ylw" "$npm_rc" "$rst"
  elif [ -n "$out" ]; then
    printf '%s%-32s %-10s %-10s%s\n' "$dim" "package" "current" "latest" "$rst"
    echo "$out" | awk '{printf "%-32s %-10s %-10s\n",$1,$2,$4}'
    if ask "npm -g install latest for these?"; then
      npm i -g @anthropic-ai/claude-code @openai/codex
    fi
  else
    printf '%sup to date%s\n' "$grn" "$rst"
  fi
else echo "${dim}npm not found${rst}"; fi

# ---------- rtk (no self-update: version-gated, pinned+verified installer) ----------
rtk_reinstall(){ # download pinned install.sh, verify sha256, then run
  local url tmp got
  if command -v brew >/dev/null 2>&1; then brew upgrade rtk; return; fi
  url="https://raw.githubusercontent.com/$RTK_REPO/$RTK_PIN_SHA/install.sh"
  tmp=$(mktemp)
  if ! curl -fsSL "$url" -o "$tmp"; then printf '%sdownload failed%s\n' "$red" "$rst"; rm -f "$tmp"; return 1; fi
  got=$(sha256sum "$tmp" | awk '{print $1}')
  if [ "$got" != "$RTK_INSTALL_SHA256" ]; then
    printf '%sinstaller SHA-256 mismatch — refusing to run%s\n  expected %s\n  got      %s\n' "$red" "$rst" "$RTK_INSTALL_SHA256" "$got"
    rm -f "$tmp"; return 1
  fi
  printf '%sinstaller verified (pinned %s)%s\n' "$grn" "${RTK_PIN_SHA:0:12}" "$rst"
  sh "$tmp"; rm -f "$tmp"
}
hdr "rtk"
if command -v rtk >/dev/null; then
  cur=$(rtk --version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1)
  latest=$(timeout 30 gh api "repos/$RTK_REPO/releases/latest" --jq .tag_name 2>/dev/null | sed 's/^v//')
  echo "installed: ${cur:-?}   latest: ${latest:-unknown}"
  if [ -z "$latest" ]; then
    printf '%scould not resolve latest release — skipping%s\n' "$dim" "$rst"
  elif [ "$cur" = "$latest" ] || [ "$(printf '%s\n%s\n' "$latest" "$cur" | sort -V | tail -1)" = "$cur" ]; then
    printf '%sup to date%s\n' "$grn" "$rst"
  else
    printf '%supdate available %s -> %s%s\n' "$ylw" "$cur" "$latest" "$rst"
    echo "${dim}will run pinned+verified installer (rtk-ai/rtk@${RTK_PIN_SHA:0:12}); never auto under -y${rst}"
    if ask_exec "reinstall rtk from pinned installer?"; then rtk_reinstall; fi
  fi
else echo "${dim}rtk not found${rst}"; fi

# ---------- herdr (native self-update; manifest is the only check-only path) ----------
# `herdr update` installs immediately — there is no --check — so compare against the same
# manifest herdr itself uses. Two channels, two manifests:
#   stable  -> latest.json  ("version": semver)  -> sort -V compare, install offered
#   preview -> preview.json (build_id over base_version). There is no reliable way to read
#              the INSTALLED preview build id, and semver compare is meaningless (preview
#              base_version == stable). Fail closed: report the latest build, never install.
# Never runs the updater from inside a herdr session — herdr itself refuses (detach first).
hdr "herdr"
if command -v herdr >/dev/null; then
  cur=$(herdr --version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1)
  chan=$(herdr channel show 2>/dev/null | grep -oE 'preview|stable' | head -1)
  if [ "$chan" = "preview" ]; then
    mani=$(timeout 30 curl -fsSL https://herdr.dev/preview.json 2>/dev/null)
    base=$(printf '%s' "$mani" | jq -r '.base_version // empty' 2>/dev/null)
    build=$(printf '%s' "$mani" | jq -r '.build_id // empty' 2>/dev/null)
    echo "installed: ${cur:-?}   channel: preview"
    if [ -z "$build" ]; then
      printf '%scould not fetch https://herdr.dev/preview.json — skipping%s\n' "$dim" "$rst"
    else
      printf '%slatest preview: %s build %s — cannot compare installed build id%s\n' "$ylw" "${base:-?}" "$build" "$rst"
      printf '%sreport-only on preview; run `herdr update` yourself (outside a herdr session)%s\n' "$dim" "$rst"
    fi
  else
    latest=$(timeout 30 curl -fsSL https://herdr.dev/latest.json 2>/dev/null | jq -r '.version // empty' 2>/dev/null)
    echo "installed: ${cur:-?}   latest: ${latest:-unknown}   channel: ${chan:-stable}"
    if [ -z "$latest" ]; then
      printf '%scould not fetch https://herdr.dev/latest.json — skipping%s\n' "$dim" "$rst"
    elif [ "$cur" = "$latest" ] || [ "$(printf '%s\n%s\n' "$latest" "$cur" | sort -V | tail -1)" = "$cur" ]; then
      printf '%sup to date%s\n' "$grn" "$rst"
    elif [ -n "${HERDR_PANE_ID:-}" ]; then
      printf '%supdate available %s -> %s — but this shell is inside a herdr session%s\n' "$ylw" "$cur" "$latest" "$rst"
      printf '%sdetach first, then run: herdr update%s\n' "$dim" "$rst"
    else
      printf '%supdate available %s -> %s%s\n' "$ylw" "$cur" "$latest" "$rst"
      if ask "run herdr update?"; then herdr update; fi
    fi
  fi
else echo "${dim}herdr not found${rst}"; fi

# ---------- own skills repo (~/skills = single source of truth) ----------
SKILLS_REPO="$HOME/skills"
hdr "own skills (~/skills)"
if [ -d "$SKILLS_REPO/.git" ]; then
  timeout 60 git -C "$SKILLS_REPO" fetch -q 2>/dev/null \
    || printf '%sfetch failed/timed out — comparison below may be stale%s\n' "$ylw" "$rst"
  if counts=$(git -C "$SKILLS_REPO" rev-list --left-right --count HEAD...@{u} 2>/dev/null); then
    ahead=${counts%%[[:space:]]*}; behind=${counts##*[[:space:]]}
    if   [ "$behind" -gt 0 ] && [ "$ahead" -eq 0 ]; then
      # same fail-closed security inspection as external skills; NEVER auto-pulls.
      if [ -x "$SKILLS_REPO/bin/skill-sync" ]; then "$SKILLS_REPO/bin/skill-sync" inspect "$SKILLS_REPO"
      else printf '%sbehind %s — review before pulling%s\n' "$ylw" "$behind" "$rst"; fi
    elif [ "$behind" -gt 0 ] && [ "$ahead" -gt 0 ]; then
      printf '%sDIVERGED (ahead %s, behind %s) — resolve manually%s\n' "$red" "$ahead" "$behind" "$rst"
    elif [ "$ahead" -gt 0 ]; then
      printf '%sahead %s (unpushed) — git push when ready%s\n' "$dim" "$ahead" "$rst"
    else printf '%sup to date%s\n' "$grn" "$rst"; fi
  else printf '%sno upstream tracking%s\n' "$dim" "$rst"; fi
else printf '%s~/skills is not a git repo — clone it and run bin/skill-link%s\n' "$dim" "$rst"; fi

# ---------- external (third-party) skills: fail-closed via skill-sync ----------
hdr "external skills (skill-sync check)"
if [ -x "$SKILLS_REPO/bin/skill-sync" ]; then
  timeout 180 "$SKILLS_REPO/bin/skill-sync" check   # read-only; applying is a separate reviewed step
  [ $? -ge 124 ] && printf '%sskill-sync check timed out (180s) — status unknown%s\n' "$ylw" "$rst"
else printf '%sskill-sync not found at %s/bin%s\n' "$dim" "$SKILLS_REPO" "$rst"; fi

# ---------- skill link map ----------
hdr "skill links"
for d in "${SKILL_DIRS[@]}"; do
  [ -d "$d" ] || continue
  echo "${bold}$d${rst}"
  for s in "$d"/*; do
    [ -e "$s" ] || continue
    name=$(basename "$s")
    if [ -L "$s" ]; then
      tgt=$(readlink "$s")
      case "$tgt" in
        "$SKILLS_REPO"/*) printf '  %s%-30s managed by ~/skills%s\n' "$grn" "$name" "$rst";;
        *)                printf '  %s%-30s symlink -> %s%s\n' "$dim" "$name" "$tgt" "$rst";;
      esac
    elif [ -d "$s/.git" ]; then
      printf '  %s%-30s external clone (skill-sync)%s\n' "$ylw" "$name" "$rst"
    else
      printf '  %s%-30s static (manual)%s\n' "$dim" "$name" "$rst"
    fi
  done
done

echo
printf '%sdone.%s\n' "$bold" "$rst"
